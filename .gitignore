# Variables de entorno
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Vite
frontend/dist/
frontend/.vite/

# Prisma (mantenemos migrations, ignoramos backups)
backend/prisma/*.db
backend/prisma/*.db-journal

# Docker
*.pid
*.seed
*.pid.lock

# Coverage / cache
coverage/
.nyc_output/
.cache/
.parcel-cache/

# Netlify / Vercel (si deployas)
.netlify/
.vercel/
